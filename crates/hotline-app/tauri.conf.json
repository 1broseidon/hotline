{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotline",
  "version": "0.17.4",
  "identifier": "dev.hotline.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QkNBODdDNDFEQUQ5NEUKUldSTzJkcEJmS2k4WnNjenVqMnVHRzVCRS9JaDZHUGgxL3puenFjdTJDdjg4VHQycHRETXYrckUK",
      "endpoints": [
        "https://github.com/1Broseidon/hotline/releases/latest/download/latest.json"
      ]
    }
  }
}
