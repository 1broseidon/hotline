{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "toad-docs",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "docs.toad.team", "custom_domain": true }],
	"workers_dev": true
}
