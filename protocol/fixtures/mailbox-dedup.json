{
  "intent": "A crash retry offers the same deterministic envelope twice. The relay returns the original M with duplicate true and no new push intent; repeated delivery of that envelope produces one logical apply before cumulative acknowledgement.",
  "assertions": [
    {
      "rule": "F4",
      "statement": "env-j520-d6c86c6aac5fb is f(520, dev-6c86c6aac5fb), is reused across the retry, and maps to the original M 9007199254741500."
    },
    {
      "rule": "F4",
      "statement": "Two mailbox_item deliveries with the same mailbox_id and envelope_id have logical_apply true then false, while both refer to the same committed local result."
    }
  ],
  "frames": [
    {
      "dir": "box->relay",
      "frame": {
        "t": "mailbox_enqueue",
        "mailbox_id": "mbx_dedup_fixture",
        "envelope_id": "env-j520-d6c86c6aac5fb",
        "class": "durable",
        "notify": "wake",
        "payload_encoding": "plain-v1",
        "payload": "{\"t\":\"msg\",\"seq\":520,\"id\":\"a-520\",\"text\":\"Apply this envelope once.\"}",
        "created_at": "2026-07-11T16:10:00Z",
        "expires_at": "2026-07-18T16:10:00Z"
      },
      "expect": {
        "route": "transport",
        "inserted": true,
        "push_intents_created": 1
      }
    },
    {
      "dir": "relay->box",
      "frame": {
        "t": "mailbox_enqueued",
        "mailbox_id": "mbx_dedup_fixture",
        "envelope_id": "env-j520-d6c86c6aac5fb",
        "mailbox_seq": "9007199254741500",
        "duplicate": false,
        "state": "queued"
      },
      "expect": {
        "route": "transport",
        "original_mailbox_seq": "9007199254741500"
      }
    },
    {
      "dir": "box->relay",
      "frame": {
        "t": "mailbox_enqueue",
        "mailbox_id": "mbx_dedup_fixture",
        "envelope_id": "env-j520-d6c86c6aac5fb",
        "class": "durable",
        "notify": "wake",
        "payload_encoding": "plain-v1",
        "payload": "{\"t\":\"msg\",\"seq\":520,\"id\":\"a-520\",\"text\":\"Apply this envelope once.\"}",
        "created_at": "2026-07-11T16:10:00Z",
        "expires_at": "2026-07-18T16:10:00Z"
      },
      "expect": {
        "route": "transport",
        "inserted": false,
        "push_intents_created": 0
      }
    },
    {
      "dir": "relay->box",
      "frame": {
        "t": "mailbox_enqueued",
        "mailbox_id": "mbx_dedup_fixture",
        "envelope_id": "env-j520-d6c86c6aac5fb",
