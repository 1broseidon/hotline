{
  "intent": "One mailbox assigns ascending decimal-string M values to ascending journal J values. A new live item enqueued during sync is held until mailbox_synced closes the captured snapshot, then one cumulative ack commits through the live M.",
  "assertions": [
    {
      "rule": "F1",
      "statement": "Within mbx_order_fixture, M 9007199254740993, 9007199254740994, and 9007199254740995 carry J 410, 411, and 412 in the same order; the box waits for each mailbox_enqueued before offering the next J."
    },
    {
      "rule": "F3",
      "statement": "The live M 9007199254740995 is accepted while the snapshot is in progress but is not delivered until after mailbox_synced through the captured head 9007199254740994."
    },
    {
      "rule": "F10",
      "statement": "Every M is a decimal JSON string above 2^53 and the final mailbox_ack is cumulative through 9007199254740995."
    }
  ],
  "frames": [
    {
      "dir": "box->relay",
      "frame": {
        "t": "mailbox_enqueue",
        "mailbox_id": "mbx_order_fixture",
        "envelope_id": "env-j410-d6c86c6aac5fb",
        "class": "durable",
        "notify": "wake",
        "payload_encoding": "plain-v1",
        "payload": "{\"t\":\"msg\",\"seq\":410,\"id\":\"a-410\",\"text\":\"First retained item.\"}",
        "created_at": "2026-07-11T16:00:00Z",
        "expires_at": "2026-07-18T16:00:00Z"
      },
      "expect": {
        "route": "transport",
        "journal_seq": 410,
        "in_flight": 1
      }
    },
    {
      "dir": "relay->box",
      "frame": {
        "t": "mailbox_enqueued",
        "mailbox_id": "mbx_order_fixture",
        "envelope_id": "env-j410-d6c86c6aac5fb",
        "mailbox_seq": "9007199254740993",
        "duplicate": false,
        "state": "queued"
      },
      "expect": {
        "route": "transport",
        "journal_seq": 410
      }
    },
    {
      "dir": "box->relay",
      "frame": {
        "t": "mailbox_enqueue",
        "mailbox_id": "mbx_order_fixture",
        "envelope_id": "env-j411-d6c86c6aac5fb",
        "class": "durable",
        "notify": "silent",
        "payload_encoding": "plain-v1",
        "payload": "{\"t\":\"sent\",\"seq\":411,\"id\":\"u-411\",\"text\":\"Second retained item.\",\"device\":\"dev-6c86c6aac5fb\"}",
        "created_at": "2026-07-11T16:00:01Z",
        "expires_at": "2026-07-18T16:00:01Z"
      },
      "expect": {
        "route": "transport",
        "journal_seq": 411,
        "previous_receipt_observed": true,
        "in_flight": 1
      }
    },
    {
      "dir": "relay->box",
      "frame": {
        "t": "mailbox_enqueued",
        "mailbox_id": "mbx_order_fixture",
        "envelope_id": "env-j411-d6c86c6aac5fb",
        "mailbox_seq": "9007199254740994",
        "duplicate": false,
        "state": "queued"
      },
      "expect": {
        "route": "transport",
        "journal_seq": 411
      }
    },
    {
      "dir": "device->relay",
