#!/usr/bin/env python3
"""A cargo runner for `cargo tauri dev` on macOS: build, sign, then launch.

Why: the login keychain recognises an app by its code-signing designated
requirement. An unsigned debug binary's requirement is its content hash, which
changes with every rebuild, so "Always Allow" on the keychain prompt never
sticks and every dev reload asks again. Signed with a developer certificate
and a fixed identifier, the requirement survives rebuilds and one "Always
Allow" per stored credential is the last one.

Tauri's dev loop calls the runner as `cargo run <flags> -- <app args>`, and
cargo would launch the binary before anyone could sign it. So `run` becomes
`cargo build <flags>`, a codesign of the artifact, then an exec of that
artifact with the app args, which keeps the PID Tauri watches. Everything else
passes through to cargo unchanged.

Set HOTLINE_DEV_SIGN_IDENTITY to choose the certificate; otherwise the first
"Apple Development" identity in the keychain is used, and with none at all
the binary stays unsigned as before.
"""
import ctypes
import json
import os
import platform
import re
import subprocess
import sys

IDENTIFIER = "dev.hotline.app.dev"
# Apple's posix_spawn flag that replaces the calling process, as execve does.
POSIX_SPAWN_SETEXEC = 0x0040


def identity():
    chosen = os.environ.get("HOTLINE_DEV_SIGN_IDENTITY")
    if chosen:
        return chosen
    listing = subprocess.run(
        ["security", "find-identity", "-v", "-p", "codesigning"],
        capture_output=True, text=True,
    ).stdout
    found = re.search(r'"(Apple Development: [^"]*)"', listing)
    return found.group(1) if found else None


def build(flags):
    """Runs cargo build and returns the executable it produced, if any."""
    process = subprocess.run(
        ["cargo", "build", *flags, "--message-format=json-render-diagnostics"],
        stdout=subprocess.PIPE, text=True,
    )
    if process.returncode != 0:
        sys.exit(process.returncode)
    executable = None
    for line in process.stdout.splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if message.get("reason") == "compiler-artifact" and message.get("executable"):
            executable = message["executable"]
    return executable


def sign(executable):
    who = identity()
    if not who:
        print("cargo-dev-sign: no Apple Development identity; the binary stays unsigned", file=sys.stderr)
        return
    subprocess.run(
        ["codesign", "--force", "--sign", who, "--identifier", IDENTIFIER, executable],
        check=True, stderr=subprocess.DEVNULL,
    )


def main(argv):
    if platform.system() != "Darwin" or not argv or argv[0] not in ("run", "build"):
        os.execvp("cargo", ["cargo", *argv])
    command, rest = argv[0], argv[1:]
    flags, app_args = rest, []
    if "--" in rest:
        split = rest.index("--")
        flags, app_args = rest[:split], rest[split + 1:]
    executable = build(flags)
    if executable:
        sign(executable)
    if command == "run":
        if not executable:
            sys.exit("cargo-dev-sign: cargo build produced no executable to run")
        exec_responsible(executable, [executable, *app_args])


def exec_responsible(executable, args):
    """Becomes the app, as exec does, but as its own responsible process.

    macOS asks the responsible process's Info.plist for a privacy prompt's
    reason. A bare binary started from a shell is the responsibility of
    whatever launched that shell (a terminal, an editor, another app), so
    asking for speech recognition there is a TCC privacy violation that
    kills the dev app. Disclaiming makes the app answer for itself with the
    Info.plist embedded in it, as an installed Hotline.app does.
    POSIX_SPAWN_SETEXEC keeps the PID, so `tauri dev` still watches and
    stops the right process. Anything unexpected falls back to plain exec.
    """
    try:
        libsystem = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
        attributes = ctypes.c_void_p()
        if libsystem.posix_spawnattr_init(ctypes.byref(attributes)) == 0:
            libsystem.posix_spawnattr_setflags(ctypes.byref(attributes), ctypes.c_short(POSIX_SPAWN_SETEXEC))
            libsystem.responsibility_spawnattrs_setdisclaim(ctypes.byref(attributes), 1)
            argv = (ctypes.c_char_p * (len(args) + 1))(*[os.fsencode(arg) for arg in args], None)
            environ = [os.fsencode(f"{key}={value}") for key, value in os.environ.items()]
            envp = (ctypes.c_char_p * (len(environ) + 1))(*environ, None)
            pid = ctypes.c_int()
            # Returns only on failure: on success this process is the app.
            libsystem.posix_spawn(ctypes.byref(pid), os.fsencode(executable), None, ctypes.byref(attributes), argv, envp)
    except (OSError, AttributeError):
        pass
    os.execv(executable, args)


if __name__ == "__main__":
    main(sys.argv[1:])
