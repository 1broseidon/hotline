{
  "ref": "hotline_grizzly_https",
  "description": "Redirect the public Hotline tunnel from HTTP to HTTPS (BRO-165)",
  "expression": "(http.host eq \"grizzly-tunnel.hotline.dev\" and http.request.scheme eq \"http\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://grizzly-tunnel.hotline.dev\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
